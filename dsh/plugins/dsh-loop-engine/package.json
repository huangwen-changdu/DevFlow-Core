{
  "name": "@devflow-core/dsh-loop-engine",
  "version": "0.2.1",
  "description": "Loop Engine 循环工程 for DeepSeek Harness: loop-engine agent preset + loop-engineering skill, synced into ~/.dsh on host startup. 独立插件，不依赖 dsh-devflow。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./assets/*": "./assets/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.js",
    "test": "node test/sync.test.js"
  }
}
